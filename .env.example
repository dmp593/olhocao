DEBUG=on
SECRET_KEY=replace-with-a-long-random-value
DATABASE_URL=sqlite:///db.sqlite3
DATABASE_CONN_MAX_AGE=60

ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000
PUBLIC_BASE_URL=http://localhost:8000

STATIC_ROOT=.staticfiles
MEDIA_ROOT=media

EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=off
EMAIL_USE_SSL=off
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=no-reply@olhocao.pt
SUPPORT_EMAIL=olhocao@olhocao.pt
RECIPIENT_LIST_ON_CONTACT_US_REQUEST=olhocao@olhocao.pt

TOCONLINE_BASE_URL=https://api17.toconline.pt
TOCONLINE_OAUTH_BASE_URL=
TOCONLINE_OAUTH_CLIENT_ID=
TOCONLINE_OAUTH_CLIENT_SECRET=
# Must exactly match the redirect URI registered for the TOConline OAuth client.
TOCONLINE_OAUTH_REDIRECT_URI=https://oauth.pstmn.io/v1/callback
TOCONLINE_TIMEOUT=10
TOCONLINE_DOCUMENT_MAX_BYTES=20971520

EASYPAY_ENVIRONMENT=sandbox
EASYPAY_ACCOUNT_ID=
EASYPAY_API_KEY=
EASYPAY_TIMEOUT=10
EASYPAY_PAYMENT_LINK_TTL_HOURS=24
EASYPAY_PAYMENT_METHODS=CC,MBW,MB
EASYPAY_WEBHOOK_USERNAME=
EASYPAY_WEBHOOK_PASSWORD=

HOTEL_REFUND_PERCENTAGE=0.85
STAY_MEDIA_MAX_UPLOAD_BYTES=104857600
CATALOG_IMAGE_MAX_UPLOAD_BYTES=10485760
FRONTOFFICE_IMAGE_MAX_UPLOAD_BYTES=10485760

SECURE_SSL_REDIRECT=off
SESSION_COOKIE_SECURE=off
CSRF_COOKIE_SECURE=off
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=off
SECURE_HSTS_PRELOAD=off
USE_X_FORWARDED_PROTO=off
LOG_LEVEL=INFO

# Local demonstration data. Keep disabled in every deployed environment.
DEMO_DATA_ALLOWED=off
DEMO_DATA_PASSWORD=
